# ==========================================
# Portfolio Backend - Environment Variables
# ==========================================

# Server Port (Render automatically sets PORT in production)
PORT=5001

# Environment mode ('development' or 'production')
NODE_ENV=development

# Supabase Credentials (PostgreSQL)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# Allowed CORS Origins (comma-separated for multiple origins)
# Example for production: https://prarthana-reddy-portfolio.onrender.com,http://localhost:5173
CORS_ORIGIN=http://localhost:5173
